# Line endings: source, scripts, metadata and checksum files are LF in the
# repository and in every working tree, regardless of the platform or
# core.autocrlf. A CRLF install.sh or SHA256SUMS breaks release verification.
*.sh text eol=lf
*.go text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
go.mod text eol=lf
go.sum text eol=lf
SHA256SUMS text eol=lf
RELEASE-METADATA.json text eol=lf

web/static/vendor/uplot/uPlot.iife.min.js text eol=lf
internal/storage/network_quality_schema22_objects_test.json text eol=lf
web/static/vendor/uplot/LICENSE text eol=lf
